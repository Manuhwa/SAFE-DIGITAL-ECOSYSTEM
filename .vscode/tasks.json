{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend",
      "type": "shell",
      "command": "npm run dev:server",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "detail": "API at http://localhost:3001 — run this first or alongside the frontend."
    },
    {
      "label": "Run Frontend",
      "type": "shell",
      "command": "npm run dev:client",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "detail": "Vite dev server at http://localhost:3000 — proxy expects the backend on 3001."
    },
    {
      "label": "Run Full Stack (backend + frontend)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "detail": "Starts both servers in one terminal (same as npm run dev)."
    }
  ]
}
